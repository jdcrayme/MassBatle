From 526a67807275ae27c7a0626ff6d274d3bef74d8d Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Thu, 29 Oct 2026 23:25:24 +0000
Subject: [PATCH] phase3-audit: one home for the soldier body geometry (A-1)

BattleTypes.h gains namespace BattleBody {RadiusM 0.4, EyeHeightM 1.6,
TopM 1.8, AimCenterM 1.0} -- the file every seam already includes.
Consumers: Contact::BodyRadiusM (BattleEngagement.h) becomes an alias;
the ranged seam drops VolleyBodyRadiusM (BattleRanged.cpp) and the raw
2.f * 0.4f blocker-query literal (RangedFireProcessor.cpp); the step
processor drops its file-local BodyRadiusM/BodyTopM and gains a named
FlyoverQueryMarginM (was the raw 0.7f). Values identical everywhere --
this is a rename, not a re-derivation. Same bits out by construction.

MUST re-run on the UE machine: unit tier (T3.1-T3.3 use 1.6f goldens;
expected green, zero drift -- the values are unchanged).
---
 .../MassBattle/Private/BattleRanged.cpp       |  7 +++----
 .../Private/ProjectileStepProcessor.cpp       | 19 +++++++++++--------
 .../Private/RangedFireProcessor.cpp           |  6 +++---
 .../MassBattle/Public/BattleEngagement.h      | 12 +++++++-----
 .../Source/MassBattle/Public/BattleRanged.h   |  2 +-
 .../Source/MassBattle/Public/BattleTypes.h    | 18 ++++++++++++++++++
 6 files changed, 43 insertions(+), 21 deletions(-)

diff --git a/Plugins/MassBattle/Source/MassBattle/Private/BattleRanged.cpp b/Plugins/MassBattle/Source/MassBattle/Private/BattleRanged.cpp
index 787bf76..24f9b54 100644
--- a/Plugins/MassBattle/Source/MassBattle/Private/BattleRanged.cpp
+++ b/Plugins/MassBattle/Source/MassBattle/Private/BattleRanged.cpp
@@ -158,8 +158,6 @@ namespace
 		const float Clamped = FMath::Clamp(T, 0.f, 1.f);
 		return FVector2D::Distance(Point, A + AB * Clamped);
 	}
-
-	constexpr float VolleyBodyRadiusM = 0.4f; // the 40 cm body radius (B-1 family: one named constant per seam)
 }
 
 int32 SelectVolleyShots(
@@ -195,8 +193,9 @@ int32 SelectVolleyShots(
 	const bool bArcedHold = Profile.bIndirect && FriendsInZone > FriendlyImpactTolerance;
 
 	// Flat-lane corridor (A7): any friendly body inside the corridor holds
-	// fire. Corridor half-width = 2 body radii + hit radius.
-	const float CorridorHalfM = 2.f * VolleyBodyRadiusM + Profile.HitRadiusM;
+	// fire. Corridor half-width = 2 body radii + hit radius (one home:
+	// BattleTypes.h's BattleBody, the B-1 rule).
+	const float CorridorHalfM = 2.f * BattleBody::RadiusM + Profile.HitRadiusM;
 
 	int32 ShotCount = 0;
 	for (FVolleyShooterView& Shooter : InOutShooters)
diff --git a/Plugins/MassBattle/Source/MassBattle/Private/ProjectileStepProcessor.cpp b/Plugins/MassBattle/Source/MassBattle/Private/ProjectileStepProcessor.cpp
index b2a5c16..3b5cf9b 100644
--- a/Plugins/MassBattle/Source/MassBattle/Private/ProjectileStepProcessor.cpp
+++ b/Plugins/MassBattle/Source/MassBattle/Private/ProjectileStepProcessor.cpp
@@ -67,10 +67,13 @@ namespace
 	// keeps corpses addressable -- this ledger is the no-double-kill guard.
 	TSet<FMassEntityHandle> GKilledLedger;
 
-	// Body geometry for the height gates (the B-1 family: named constants;
-	// values mirror the hash entry's 40 cm body radius and the ~1.8 m body).
-	constexpr float BodyRadiusM = 0.4f;
-	constexpr float BodyTopM = 1.8f;
+	// Body geometry for the height gates: ONE home (BattleTypes.h's
+	// BattleBody) -- the same 40 cm radius the contact ring and the ranged
+	// corridors read. FlyoverQueryMarginM: how far above body top the
+	// mid-segment must sit before the pass skips the impact query entirely
+	// (R-R2's cheap gate; conservative by design -- the candidate gate
+	// itself uses no margin).
+	constexpr float FlyoverQueryMarginM = 0.7f;
 
 	/** Point-to-segment distance, 2D (the swept-segment corridor test). */
 	float SegmentDist2D(const FVector2D& Point, const FVector2D& A, const FVector2D& B)
@@ -160,13 +163,13 @@ void RunProjectileStepPass(UWorld* World, float DeltaSeconds)
 		const FVector2D Mid = (Pre + Post) * 0.5f;
 		const float HalfSeg = FVector2D::Distance(Pre, Post) * 0.5f;
 		const float GroundMid = Grid.SampleHeight(Mid);
-		if (MidZ > GroundMid + BodyTopM + 0.7f)
+		if (MidZ > GroundMid + BattleBody::TopM + FlyoverQueryMarginM)
 		{
 			continue; // above every body: no query (the R-R2 early-out)
 		}
 
 		const FProjectileProfile Profile = GetProjectileProfile(static_cast<EBattleProjectileKind>(Pool.Kind[Slot]));
-		const float CorridorM = HalfSeg + Profile.HitRadiusM + BodyRadiusM;
+		const float CorridorM = HalfSeg + Profile.HitRadiusM + BattleBody::RadiusM;
 		GHitEntries.Reset();
 		GHitPositions.Reset();
 		if (Hash)
@@ -202,7 +205,7 @@ void RunProjectileStepPass(UWorld* World, float DeltaSeconds)
 				continue;
 			}
 			const float Dist = SegmentDist2D(GHitPositions[i], Pre, Post);
-			if (Dist > Profile.HitRadiusM + BodyRadiusM)
+			if (Dist > Profile.HitRadiusM + BattleBody::RadiusM)
 			{
 				continue;
 			}
@@ -211,7 +214,7 @@ void RunProjectileStepPass(UWorld* World, float DeltaSeconds)
 			const float T = FMath::Clamp(FVector2D::DotProduct(GHitPositions[i] - Pre, SegAB) / SegLenSq, 0.f, 1.f);
 			const float ZAtT = FMath::Lerp(GPreZ[Slot], Pool.PosZ[Slot], T);
 			const float GroundI = Grid.SampleHeight(GHitPositions[i]);
-			if (ZAtT > GroundI + BodyTopM)
+			if (ZAtT > GroundI + BattleBody::TopM)
 			{
 				continue; // passes overhead
 			}
diff --git a/Plugins/MassBattle/Source/MassBattle/Private/RangedFireProcessor.cpp b/Plugins/MassBattle/Source/MassBattle/Private/RangedFireProcessor.cpp
index 718b091..69c2216 100644
--- a/Plugins/MassBattle/Source/MassBattle/Private/RangedFireProcessor.cpp
+++ b/Plugins/MassBattle/Source/MassBattle/Private/RangedFireProcessor.cpp
@@ -258,7 +258,7 @@ void RunRangedFirePass(UWorld* World, float DeltaSeconds)
 				Shooter.Unit = Handle;
 				Shooter.RosterIndex = RosterIdx++;
 				Shooter.PosM = FVector2D(P.X, P.Y) * 0.01f;
-				Shooter.EyeZM = 1.6f; // A6 placeholder launch height
+				Shooter.EyeZM = BattleBody::EyeHeightM; // A6 placeholder launch height (one home: BattleTypes.h)
 				Shooter.Kind = Ranged->Kind;
 				Shooter.RangeM = Ranged->RangeM;
 				Shooter.Ammo = Ranged->AmmoCount;
@@ -313,7 +313,7 @@ void RunRangedFirePass(UWorld* World, float DeltaSeconds)
 		const FProjectileProfile Profile = GetProjectileProfile(GShooters[0].Kind);
 		FVolleyTargetView Target;
 		Target.PosM = *TargetAnchor;
-		Target.ZM = Grid.SampleHeight(*TargetAnchor) + 1.0f; // body-center aim
+		Target.ZM = Grid.SampleHeight(*TargetAnchor) + BattleBody::AimCenterM; // body-center aim (one home)
 		Target.Unit = TargetUnit;
 
 		// -- Friendly blockers through the spatial hash (A7's sanctioned
@@ -326,7 +326,7 @@ void RunRangedFirePass(UWorld* World, float DeltaSeconds)
 			const float DistM = FVector2D::Distance(GShooters[0].PosM, Target.PosM);
 			const float QueryRadiusM = Profile.bIndirect
 				? DistM * FMath::Tan(FMath::DegreesToRadians(FMath::Max(Profile.DispersionDeg, 0.01f))) + Profile.HitRadiusM + 2.f
-				: DistM * 0.5f + 2.f * 0.4f + Profile.HitRadiusM + 2.f;
+				: DistM * 0.5f + 2.f * BattleBody::RadiusM + Profile.HitRadiusM + 2.f;
 			const FVector2D QueryCenterM = Profile.bIndirect
 				? Target.PosM
 				: (*TargetAnchor + GShooters[0].PosM) * 0.5f;
