From 265dcc21fa00e66c7ded00f9dbb53f9b4743b97e Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Thu, 29 Oct 2026 23:34:51 +0000
Subject: [PATCH] phase3-audit: one home for the ranged session-on cvar list in
 the test module (C-tier)

The Battle.Ranged.{Enable,Fire,Step,Skirmish} list was re-typed as local
arrays in three scenario classes (S6Volley, SkirmishBehavior,
DeterminismTwoRun -- Set + Restore each). ONE helper pair
(RangedSetCvars/RangedRestoreCvars) beside the existing ClashSetCvars owns
the list; the three classes call it. Same sets flipped, same save/restore
semantics -- pure dedup.

MUST re-run on the UE machine: func tier (the three scenario classes are
the consumers; S6/Skirmish expected green, DeterminismTwoRun keeps its
disclosed blocker).
---
 .../Private/BattleFuncTestActor.cpp           | 101 +++++++-----------
 1 file changed, 38 insertions(+), 63 deletions(-)

diff --git a/Plugins/MassBattle/Source/MassBattleTest/Private/BattleFuncTestActor.cpp b/Plugins/MassBattle/Source/MassBattleTest/Private/BattleFuncTestActor.cpp
index 16cdb19..b1f4569 100644
--- a/Plugins/MassBattle/Source/MassBattleTest/Private/BattleFuncTestActor.cpp
+++ b/Plugins/MassBattle/Source/MassBattleTest/Private/BattleFuncTestActor.cpp
@@ -4917,6 +4917,38 @@ namespace
 		}
 	}
 
+	// The ranged session-on list (ONE home, the phase-3 audit's C-tier fix):
+	// previously re-typed as local arrays in three scenario classes.
+	constexpr const TCHAR* RangedCvars[] = {
+		TEXT("Battle.Ranged.Enable"),
+		TEXT("Battle.Ranged.Fire"),
+		TEXT("Battle.Ranged.Step"),
+		TEXT("Battle.Ranged.Skirmish"),
+	};
+
+	void RangedSetCvars(int32 (&Saved)[4])
+	{
+		for (int32 i = 0; i < 4; ++i)
+		{
+			if (IConsoleVariable* C = IConsoleManager::Get().FindConsoleVariable(RangedCvars[i]))
+			{
+				Saved[i] = C->GetInt();
+				C->Set(1, ECVF_SetByCode);
+			}
+		}
+	}
+
+	void RangedRestoreCvars(int32 (&Saved)[4])
+	{
+		for (int32 i = 0; i < 4; ++i)
+		{
+			if (IConsoleVariable* C = IConsoleManager::Get().FindConsoleVariable(RangedCvars[i]))
+			{
+				C->Set(Saved[i], ECVF_SetByCode);
+			}
+		}
+	}
+
 	AUnitActor* ClashSpawnActor(UWorld* World, int32 EduRow, int32 Count, const FVector2D& PosM, float YawDeg)
 	{
 		FActorSpawnParameters Params;
@@ -5630,17 +5662,7 @@ void ADeterminismTwoRunTest::SetCvars()
 			C->Set(1, ECVF_SetByCode);
 		}
 	}
-	static const TCHAR* RangedNames[4] = {
-		TEXT("Battle.Ranged.Enable"), TEXT("Battle.Ranged.Fire"),
-		TEXT("Battle.Ranged.Step"), TEXT("Battle.Ranged.Skirmish") };
-	for (int32 i = 0; i < 4; ++i)
-	{
-		if (IConsoleVariable* C = IConsoleManager::Get().FindConsoleVariable(RangedNames[i]))
-		{
-			SavedRanged[i] = C->GetInt();
-			C->Set(1, ECVF_SetByCode);
-		}
-	}
+	RangedSetCvars(SavedRanged);
 }
 
