index 7793bcd..db8cead 100644
--- a/Plugins/MassBattle/Source/MassBattleTest/Private/MassBattleFuncTestHarness.cpp
+++ b/Plugins/MassBattle/Source/MassBattleTest/Private/MassBattleFuncTestHarness.cpp
@@ -712,8 +712,6 @@ bool FCombatSmoke::RunTest(const FString& Parameters)
 	return true;
 }
 
-#endif // WITH_DEV_AUTOMATION_TESTS
