+	int32 ShotCount = 0;
+	for (FVolleyShooterView& Shooter : InOutShooters)
+	{
+		// -- eligibility (RC1), cheapest tests first --
+		if (Shooter.ReloadTimer > 0.f || Shooter.Ammo <= 0 || Shooter.Rank >= MaxRank)
+		{
