# Auto detect text files and perform LF normalization
* text=auto

# Core Unreal Engine file types
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
# Audit M19: .uproject is a small TEXT file -- LFS routing it made every
# clone yield a 129-byte pointer blob as the project file (unbuildable
# without git-lfs smudge). It now rides normal git text.


# Common binary assets
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# EDU data fixtures: enforce LF on disk (parser contract: ASCII + LF)
Data/**/*.txt text eol=lf
